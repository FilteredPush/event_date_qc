<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging for the unit and integration tests (Maven and Eclipse both put src/test/resources on the
     test classpath, so this configuration is used in both).  The library logs through Apache Commons
     Logging; with log4j-core on the test classpath, Commons Logging 1.3 sends that to Log4j, and
     log4j-slf4j2-impl sends the logging of dependencies that use SLF4J to the same place.
     For more detail, set the org.filteredpush level to DEBUG. -->
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %c{1.} - %msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Logger name="org.filteredpush" level="INFO"/>
    <Root level="WARN">
      <AppenderRef ref="Console"/>
    </Root>
  </Loggers>
</Configuration>
